{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/backup",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/avisos?h=8",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/avisos?h=9",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/avisos?h=10",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/avisos?h=11",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/avisos?h=12",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/avisos?h=13",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/avisos?h=14",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/avisos?h=15",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/avisos?h=16",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/avisos?h=17",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/avisos?h=18",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/avisos?h=19",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/avisos?h=20",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/avisos?h=21",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/avisos?h=22",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/avisos?h=23",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/avisos?h=0",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/avisos?h=1",
      "schedule": "0 1 * * *"
    }
  ]
}